{
  "name": "dsh-doudizhu-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "login": "wrangler login",
    "whoami": "wrangler whoami",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create dsh-doudizhu",
    "kv:create": "wrangler kv namespace create KVPUBLIC",
    "r2:create": "wrangler r2 bucket create dsh-doudizhu-avatars",
    "migrate:local": "wrangler d1 migrations apply dsh-doudizhu --local",
    "migrate:prod": "wrangler d1 migrations apply dsh-doudizhu --remote"
  },
  "dependencies": {
    "hono": "^4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "wrangler": "^4"
  }
}
