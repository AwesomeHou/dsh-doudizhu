# =============================================================
# dsh-doudizhu Worker 配置模板
# 复制为 wrangler.toml 并填入真实值；真实文件不入库（.gitignore）
# 参考：https://developers.cloudflare.com/workers/wrangler/configuration/
# =============================================================

name = "dsh-doudizhu"
main = "src/index.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]

# 从 `wrangler whoami` 获取
account_id = "REPLACE_ME"

# 部署用域名/路由（可选；本地 dev 不需要）
# routes = [
#   { pattern = "api.doudizhu.example.com", zone_id = "REPLACE_ME" }
# ]

# ---- Durable Objects：对局房间 + 匹配队列 ----
[[durable_objects.bindings]]
name = "ROOM"
class_name = "Room"

[[durable_objects.bindings]]
name = "QUEUE"
class_name = "Queue"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Room"]

[[migrations]]
tag = "v2"
new_sqlite_classes = ["Queue"]

# ---- D1 数据库 ----
[[d1_databases]]
binding = "DB"
database_name = "dsh-doudizhu"
database_id = "REPLACE_ME"

# ---- KV ----
[[kv_namespaces]]
binding = "KVPUBLIC"
id = "REPLACE_ME"

# ---- R2（自定义头像存储）----
# 暂缓：启用 R2 需绑定支付方式（用户决定后移）。启用后取消注释：
# [[r2_buckets]]
# binding = "AVATARS"
# bucket_name = "dsh-doudizhu-avatars"

# ---- 定时任务（埋点聚合，每小时）----
# [triggers]
# crons = ["0 * * * *"]

# ---- 环境变量（务必用 wrangler secret 注入，勿写死）----
#   echo "<value>" | wrangler secret put AUTH_SECRET
#   echo "<value>" | wrangler secret put ANALYTICS_INGEST_KEY
#   echo "<value>" | wrangler secret put ADMIN_KEY
# [vars]
# PUBLIC_API_ORIGIN = "https://dsh-doudizhu.<account>.workers.dev"
